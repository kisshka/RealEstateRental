@model IEnumerable<Real_Estate_Rental_Practic.Models.Owner>

@{
    ViewData["Title"] = "Арендодатели";
}
<div class="main-container">

<h1>Арендодатели</h1>


<div class="items-container">
@if(User.IsInRole("Admin"))
  {
    <div class="btn-create">
      <a asp-action="Create" class="button-main">Добавить</a>
      <a asp-action="Export" class="button-main">Экспорт</a>
    </div>
  }


@foreach (var item in Model) {
  @if(User.IsInRole("Admin"))
  {
    <a asp-action="Edit" asp-route-id="@item.IdOwner"  title="Редактировать">
            <div class="item-container">
            <div class="item-content">
            <h2>
                    @Html.DisplayFor(modelItem => item.Surname)

                    @Html.DisplayFor(modelItem => item.Name)

                    @Html.DisplayFor(modelItem => item.Patronymic)
            </h2>
            <p>
            Адрес:
            г.    @Html.DisplayFor(modelItem => item.Town)
            ул.   @Html.DisplayFor(modelItem => item.Street)
            дом   @Html.DisplayFor(modelItem => item.Home)
            кв.   @Html.DisplayFor(modelItem => item.Flat)
            </p>

            <p>
              E-mail:  @Html.Raw(item.EmailAddress)   
            </p>
        </div>
    <div class="btn-container">
            <div class="p">
            <h4>
              <span> +@Html.DisplayFor(modelItem => item.PhoneNumber)  </span>
            </h4>
            </div>
            </div>

      </div>

    </a>
}
  else
  {
        <div class="item-container">
            <div class="item-content">
            <h2>
                    @Html.DisplayFor(modelItem => item.Surname)

                    @Html.DisplayFor(modelItem => item.Name)

                    @Html.DisplayFor(modelItem => item.Patronymic)
            </h2>
            <p>
            Адрес:
            г.    @Html.DisplayFor(modelItem => item.Town)
            ул.   @Html.DisplayFor(modelItem => item.Street)
            дом   @Html.DisplayFor(modelItem => item.Home)
            кв.   @Html.DisplayFor(modelItem => item.Flat)
            </p>

            <p>
              E-mail:  @Html.DisplayFor(modelItem => item.EmailAddress)   
            </p>
        </div>
    <div class="btn-container">
            <div class="p">
            <h4>
              <span> +@Html.DisplayFor(modelItem => item.PhoneNumber)  </span>
            </h4>
            </div>
            </div>

      </div>
  }
}

</div>
</div>
