@model Real_Estate_Rental_Practic.Models.Owner

@{
    ViewData["Title"] = "Delete";
}

<div class="main-container">
<div class="items-container">
<h1>Удаление арендодателя</h1>

<h3>Вы уверены, что хотите удалить объект?</h3>
    <div class="item-container">
    <div class="form-container">
    <h2>Данные об объекте</h2>
    <hr />

        <label>ФИО:
            @Html.DisplayFor(model => model.Surname)
            @Html.DisplayFor(model => model.Name)
            @Html.DisplayFor(model => model.Patronymic)
        </label>
        <label>Номер телефона:
            +@Html.DisplayFor(model => model.PhoneNumber)
        </label>
        <label>Адрес:
           г. @Html.DisplayFor(model => model.Town)
            ул. @Html.DisplayFor(model => model.Street)
            дом @Html.DisplayFor(model => model.Home)
            кв. @Html.DisplayFor(model => model.Flat)
        </label>
        <label>
        E-mail:
            @Html.DisplayFor(model => model.EmailAddress)
        </label>
</div>
</div>
        <div class ="btn-container-under-page">
            <div class= "inline-buttons">
                <form asp-action="Delete">
                    <a asp-action="Edit" asp-route-id="@Model.IdOwner" class="button-main">Отмена</a>
                    <input type="hidden" asp-for="IdOwner" />
                    <input type="submit" value="Удалить" class="button-delete" />
                </form>
            </div>
        </div>

</div>
</div>