@model IEnumerable<Real_Estate_Rental_Practic.Models.User>

@{
    ViewData["Title"] = "Арендаторы";
}
<div class="main-container">
<h1>Арендаторы</h1>
<div class="items-container">

    @if(User.IsInRole("Admin"))
    {
        <div class="btn-create">
        <a asp-action="Create" class="button-main">Добавить</a>
        </div>
    }

@foreach (var item in Model) {
<a asp-action="Edit" asp-route-id="@item.IdUser"  title="Редактировать">
    <div class="item-container">
        <div class="item-content">
        <h2>
                @Html.DisplayFor(modelItem => item.Surname)
                @Html.DisplayFor(modelItem => item.Name)
                @Html.DisplayFor(modelItem => item.Patronymic)
        </h2>
        <p>
            E-mail:  @Html.Raw(item.EmailAddress)   
        </p>
        </div>
            
        <div class="btn-container">
            <div class="p">
            <h4>
            <span> +@Html.DisplayFor(modelItem => item.PhoneNumber)  </span>
            </h4>
            </div>
        </div>

  </div>
</a>
}
</div>
</div>

