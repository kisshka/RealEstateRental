@model Real_Estate_Rental_Practic.Models.User

@{
    ViewData["Title"] = "Изменение арендатора";
}

<div class="main-container">
<div class="items-container">
<h1>Изменение арендатора</h1>

    <form asp-action="Edit">
        <div class="item-container">
        <div class="form-container">
        <h2>Данные об объекте</h2>
        <hr />

            <input type="hidden" asp-for="IdUser" />
            
            <div class= "inline-form">
                <label asp-for="Surname" class="control-label">Фамилия</label>
                <input asp-for="Surname" class="input-form-text" />
            </div>
                <span asp-validation-for="Surname" class="validation-text"></span>

            <div class= "inline-form">
                <label asp-for="Name" class="control-label">Имя</label>
                <input asp-for="Name" class="input-form-text" />
            </div>
                <span asp-validation-for="Name" class="validation-text"></span>

            <div class= "inline-form">
                <label asp-for="Patronymic" class="control-label">Отчество</label>
                <input asp-for="Patronymic" class="input-form-text" />
            </div>
                <span asp-validation-for="Patronymic" class="validation-text"></span>

            <div class= "inline-form">
                <label asp-for="PhoneNumber" class="control-label">Номер телефона</label>
                <input asp-for="PhoneNumber" class="input-form-text" />
            </div>
                <span asp-validation-for="PhoneNumber" class="validation-text"></span>

            <div class= "inline-form">
                <label asp-for="EmailAddress" class="control-label">E-mail</label>
                <input asp-for="EmailAddress" class="input-form-text" />
            </div>
                <span asp-validation-for="EmailAddress" class="validation-text"></span>

        <p></p>
        </div>
        </div>
                    <div class ="btn-container-under-page">
                        <div class= "inline-buttons">
                            <a asp-action="Index" class="button-main">Отмена</a>
                            <input type="submit" value="Сохранить" class="button-main" />
                            <a asp-action="Delete" class="button-delete" asp-route-id="@Model.IdUser">Удалить</a>
                        </div>
                    </div>
        </form>
</div>
</div>